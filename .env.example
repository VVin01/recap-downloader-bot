# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API Key for Myanmar TikTok Viral Recap Translation
# Get your free API key at Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# AI Whisper Model for generating SRT subtitles when video has no captions
# Options: tiny (fastest, ~75MB), base (recommended, ~140MB), small (higher accuracy, ~460MB)
WHISPER_MODEL=base

# Local Telegram Bot API (Docker) Configuration
# Connects to Docker container running aiogram/telegram-bot-api
# Unlocks 2000MB (2GB) Upload and Download limit!
# Options: 'auto' (detects if port 8081 is active), 'true' (force enable), 'false' (use official cloud API)
USE_LOCAL_BOT_API=auto
LOCAL_BOT_API_URL=http://127.0.0.1:8081
